# S32 Design Studio workspace state (machine/user specific)
/.metadata/
/RemoteSystemsTempFiles/
/.s32ds_packages_support/

# Task-aware debugger runtime logs; milestone copies belong under evidence/
/FreeRTOS_TAD_logs/
/ZephyrRTOS_TAD_logs/

# Managed-build output directories. Keep Project_Settings/Debugger tracked.
**/Debug/
**/Release/
**/Debug_FLASH/
**/Release_FLASH/
**/Debug_RAM/
**/Release_RAM/

# Versioned milestone/release archives (distinct from S32DS build output)
!release/
!release/.gitkeep
!release/*.7z

# Compiler, linker, and image artifacts
*.o
*.obj
*.d
*.args
*.a
*.elf
*.map
*.hex
*.srec
*.s19
*.mot
*.bin
*.lst

# S32 Configuration Tools scratch/export files; the .mex files are authoritative
**/ClockConfigurationMappings.txt
**/ClockYaml.txt

# Third-party reference documents are catalogued in docs/REFERENCES.md
/*.pdf

# Editor and operating-system noise
*~
*.bak
*.swp
.DS_Store
Thumbs.db
desktop.ini

